# App
APP_NAME=RecoverAI
ENV=development
API_PREFIX=/api

# Database (SQLite by default for local boilerplate; swap for Postgres in prod)
DATABASE_URL=sqlite:///./recoverai.db

# Celery / Redis (only needed if running background workers)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Service (Groq). Leave blank to use the deterministic rule-based fallback.
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Policy engine defaults
MAX_RECOVERY_ATTEMPTS=3
COST_TO_RECOVER_THRESHOLD=50
QUIET_HOURS_START=21:00
QUIET_HOURS_END=09:00

# CORS
FRONTEND_ORIGIN=http://localhost:5173
